% basics:
% Metric symbol, open & closed balls, metric shortcut
\DeclareMathOperator{\metric}{\delta}
\newcommand\ball[2][\metric]{\operatorname{B}_{#1} \left( #2 \right)}
\newcommand\ballp[3][\metric]{\operatorname{B}_{#1} \left( #3,~ #2 \right)}

\newcommand\cball[2][\metric]{\operatorname{B}_{#1} \left[ #2 \right]}
\newcommand\cballp[3][\metric]{\operatorname{B}_{#1} \left( #3,~ #2 \right)}

\newcommand\metr[3][]{\metric_{#1} \left( #2, ~ #3 \right)}
\newcommand\metro[1]{\metric \left( #1 \right)}


